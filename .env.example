# 复制为 .env 后填写；.env 已在 .gitignore 中，不会进仓库

# ---- B 站（强烈建议填，见 README「风控」一节）----
# 从浏览器 DevTools -> Network -> 任意 api.bilibili.com 请求 -> Request Headers -> Cookie 整段复制
# 只需 buvid3、buvid4、b_nut、bili_ticket（匿名设备标识，过风控用）
# ⚠️ 务必删掉 SESSDATA=...; bili_jct=...; DedeUserID=...; 这三段 ——
#    它们是登录态凭证，等价于账号密码，而抓公开视频根本不需要。
#    可用 tools/clean_cookie.py 自动清洗。详见 COOKIE.md
BILI_COOKIE=

# 请求节流（秒）。GitHub Actions 是数据中心 IP，比家用 IP 更敏感，别调太小。
# 每次请求间隔 = BILI_MIN_INTERVAL + random(0, BILI_JITTER)
BILI_MIN_INTERVAL=1.5
BILI_JITTER=0.8

# ---- LLM（必填）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120

# ---- 邮件（必填，用授权码不是登录密码）----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USER=你的QQ号@qq.com
SMTP_PASSWORD=你的SMTP授权码
MAIL_FROM=你的QQ号@qq.com
MAIL_TO=收件邮箱@qq.com,另一个邮箱@163.com

# ---- 可选 ----
# Guardian Open Platform 免费 key（有全文，效果最好）：https://open-platform.theguardian.com/access
GUARDIAN_API_KEY=
FALLBACK_ENABLED=1
DRY_RUN=0
FORCE_FALLBACK=0
SKIP_MAIL=0